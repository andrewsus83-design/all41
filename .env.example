# Copy to .env.local for local development. Never commit real values.
# Find the Supabase values under Project Settings > API in the dashboard.

# The shared Supabase project (dayoneproject).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The public address of this deployment: http://localhost:3000 locally,
# https://all41.app in production. Defaults to https://all41.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
